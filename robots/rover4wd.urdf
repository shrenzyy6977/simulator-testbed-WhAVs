<?xml version="1.0"?>
<!-- Generic small 4WD skid-steer sidewalk rover (the default robot of every experiment so far).
     Dimensions and masses are placeholders; the real Earth Rover Mini+ is earthrover_mini_plus.urdf. -->
<robot name="rover4wd">
  <mujoco>
    <compiler discardvisual="false" fusestatic="false" balanceinertia="true"/>
  </mujoco>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.025" iyy="0.042" izz="0.060" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <geometry><box size="0.34 0.24 0.10"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.34 0.24 0.10"/></geometry>
    </visual>
  </link>

  <!-- wheels: radius 0.065 m, width 0.04 m; wheelbase 0.16 m, track 0.30 m. Skid-steer robots keep the
       wheelbase shorter than the track so they can turn on the spot. -->
  <link name="wheel_fl">
    <inertial><mass value="0.2"/><inertia ixx="2.4e-4" iyy="4.2e-4" izz="2.4e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.065" length="0.04"/></geometry></collision>
  </link>
  <link name="wheel_fr">
    <inertial><mass value="0.2"/><inertia ixx="2.4e-4" iyy="4.2e-4" izz="2.4e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.065" length="0.04"/></geometry></collision>
  </link>
  <link name="wheel_rl">
    <inertial><mass value="0.2"/><inertia ixx="2.4e-4" iyy="4.2e-4" izz="2.4e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.065" length="0.04"/></geometry></collision>
  </link>
  <link name="wheel_rr">
    <inertial><mass value="0.2"/><inertia ixx="2.4e-4" iyy="4.2e-4" izz="2.4e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.065" length="0.04"/></geometry></collision>
  </link>

  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_fl"/>
    <origin xyz="0.08 0.15 -0.04"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_fr"/>
    <origin xyz="0.08 -0.15 -0.04"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_rl"/>
    <origin xyz="-0.08 0.15 -0.04"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_rr"/>
    <origin xyz="-0.08 -0.15 -0.04"/><axis xyz="0 1 0"/>
  </joint>
</robot>
